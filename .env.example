# Sao chép thành .env rồi điền. File .env bị .gitignore — KHÔNG commit, KHÔNG gửi cho ai.

# --- MT5 (PF Markets) ---
# Lấy ở email mở tài khoản hoặc MT5: File → Login to Trade Account. Server phải đúng y tên hiện trong MT5.
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
# Tuỳ chọn: đường dẫn terminal64.exe nếu máy cài nhiều MT5
MT5_PATH=
# Tài khoản thật bị khoá đặt lệnh, trừ khi đổi thành true
ALLOW_LIVE_TRADING=false

# --- Telegram ---
# Tạo bot với @BotFather → /newbot → nhận token
TELEGRAM_BOT_TOKEN=
# Chat id được phép điều khiển bot, cách nhau bởi dấu phẩy. Để trống, chạy bot, nhắn /id để lấy.
TELEGRAM_ALLOWED_CHAT_IDS=
